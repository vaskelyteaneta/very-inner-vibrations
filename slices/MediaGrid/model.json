{
  "description": "Reusable grid OR slider of media items (video / image / embed / text), each with a caption, size and optional link.",
  "id": "media_grid",
  "name": "MediaGrid",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Default",
      "docURL": "...",
      "id": "default",
      "imageUrl": "https://images.prismic.io/slice-machine/621a5ec4-0387-4bc5-9860-2dd46cbc07cd_default_ss.png?auto=compress,format",
      "items": {},
      "name": "Default",
      "primary": {
        "shared_caption": {
          "config": {
            "allowTargetBlank": false,
            "label": "Shared caption (optional — used when every item shares the same caption, instead of filling in each item's own Caption field)",
            "multi": "paragraph,strong,em",
            "placeholder": ""
          },
          "type": "StructuredText"
        },
        "section_title": {
          "config": {
            "allowTargetBlank": false,
            "label": "TITLE",
            "multi": "paragraph,strong,em",
            "placeholder": ""
          },
          "type": "StructuredText"
        },
        "display_mode": {
          "config": {
            "default_value": "Grid",
            "label": "Display mode",
            "options": [
              "Grid",
              "Slider"
            ],
            "placeholder": ""
          },
          "type": "Select"
        },
        "items_per_row": {
          "config": {
            "default_value": "1",
            "label": "Items per row (Grid) / slides per view (Slider)",
            "options": [
              "1",
              "2",
              "3",
              "4"
            ],
            "placeholder": ""
          },
          "type": "Select"
        },
        "gaps": {
          "config": {
            "default_value": "normal",
            "label": "Gaps (spacing between items & grid width)",
            "options": [
              "normal",
              "full-screen"
            ],
            "placeholder": ""
          },
          "type": "Select"
        },
        "items": {
          "config": {
            "fields": {
              "content_type": {
                "config": {
                  "default_value": "Image",
                  "label": "Content type",
                  "options": [
                    "Video",
                    "Image",
                    "Embed",
                    "Text"
                  ],
                  "placeholder": ""
                },
                "type": "Select"
              },
              "video": {
                "config": {
                  "label": "Video file (.mp4 upload)",
                  "placeholder": "Upload or select an mp4",
                  "select": "media"
                },
                "type": "Link"
              },
              "video_url": {
                "config": {
                  "label": "Video URL (.m3u8 HLS stream or .mp4) — paste an external link; overrides the uploaded file above",
                  "placeholder": "https://…/playlist.m3u8"
                },
                "type": "Text"
              },
              "poster": {
                "config": {
                  "constraint": {},
                  "label": "Poster / still image (Video) — when set, the grid shows this still and clicking it follows the item's Link instead of playing inline",
                  "thumbnails": []
                },
                "type": "Image"
              },
              "image": {
                "config": {
                  "constraint": {},
                  "label": "Image",
                  "thumbnails": []
                },
                "type": "Image"
              },
              "embed": {
                "config": {
                  "label": "Embed (YouTube / Vimeo / SoundCloud)",
                  "placeholder": "Paste a URL"
                },
                "type": "Embed"
              },
              "text": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Text",
                  "multi": "paragraph,preformatted,heading2,heading3,strong,em,hyperlink,list-item,o-list-item",
                  "placeholder": ""
                },
                "type": "StructuredText"
              },
              "caption": {
                "config": {
                  "allowTargetBlank": false,
                  "label": "Caption (Enter = new row)",
                  "multi": "paragraph,strong,em",
                  "placeholder": ""
                },
                "type": "StructuredText"
              },
              "link": {
                "config": {
                  "allowTargetBlank": true,
                  "label": "Link (optional — makes the item clickable)",
                  "placeholder": "",
                  "select": null
                },
                "type": "Link"
              },
              "size": {
                "config": {
                  "default_value": "medium",
                  "label": "Size (Grid mode only)",
                  "options": [
                    "small",
                    "medium",
                    "large",
                    "full-screen"
                  ],
                  "placeholder": ""
                },
                "type": "Select"
              },
              "object_fit": {
                "config": {
                  "default_value": "contain",
                  "label": "Image fit",
                  "options": [
                    "contain",
                    "cover",
                    "fill"
                  ],
                  "placeholder": ""
                },
                "type": "Select"
              },
              "image_height": {
                "config": {
                  "default_value": "auto",
                  "label": "Image height",
                  "options": [
                    "auto",
                    "300px",
                    "400px",
                    "500px",
                    "600px",
                    "700px",
                    "800px"
                  ],
                  "placeholder": ""
                },
                "type": "Select"
              }
            },
            "label": "Items"
          },
          "type": "Group"
        }
      },
      "version": "initial"
    }
  ]
}